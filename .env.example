# ==============================================================================
# STAR FOX 3 — CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env)
# ==============================================================================
# Copia este archivo como .env y reemplaza los valores por los de tu consola de Firebase:
# cp .env.example .env
#
# Nota: Si no configuras Firebase, el juego funcionará en modo local / offline
# guardando todo el progreso en localStorage.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT (Públicas — Usadas en el navegador para Auth del alumno/profesor)
# Obtén estos valores en:
# Firebase Console > Configuración del Proyecto (Project Settings) > General > Tus apps (Web)
# ------------------------------------------------------------------------------
PUBLIC_FIREBASE_API_KEY=tu_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (Privadas — Solo accesibles en el servidor SvelteKit)
# Obtén estos valores en:
# Firebase Console > Configuración del Proyecto > Cuentas de servicio (Service accounts)
# Haz clic en "Generar nueva clave privada" y descarga el archivo JSON.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com

# La clave privada puede incluir \n literales o saltos de línea reales entre comillas dobles:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. CORREO CORPORATIVO STARFOX CORP (Opcional — Envío desde tu dominio vía Resend)
# Si configuras RESEND_API_KEY con tu dominio verificado (startfoxy.braydev.xyz),
# el servidor enviará el correo HTML personalizado en español desde StarFox Corp.
# Si se deja vacío, usará el correo de Firebase Auth en español e imprimirá el link en consola.
# ------------------------------------------------------------------------------
EMAIL_FROM="StarFox Corp <noreply@starfox.braydev.xyz>"
RESEND_API_KEY=
